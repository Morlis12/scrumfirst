# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Auth.js (NextAuth v5) — JWT session strategy, credentials provider.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32"
# Required behind a reverse proxy / docker (self-hosted VPS).
AUTH_TRUST_HOST="true"

# Stable encryption key for Next.js Server Actions (multi-instance / self-hosted).
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="change-me-openssl-rand-base64-32"

# Seed de démo — mots de passe locaux UNIQUEMENT, jamais versionnés avec de vraies valeurs.
# Copiez ce fichier vers `.env` puis remplacez chaque placeholder.
# Génération suggérée : openssl rand -base64 12
SEED_ADMIN_PASSWORD="change-me-seed-admin"
SEED_DEV_PASSWORD="change-me-seed-dev"
SEED_SM_PASSWORD="change-me-seed-sm"
SEED_SH_PASSWORD="change-me-seed-sh"
